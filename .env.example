# Oracle 데이터베이스 설정
TNS_ADMIN=
WALLET_PATH=
DB_USER=
DB_PASSWORD=
WALLET_PASSWORD=

# Oracle 서비스명
ORACLE_SERVICE_NAME=

# 모델 경로
MODEL_PATH=./ckpt/best.pth

# 서버 설정
HOST=
PORT=
WORKERS=

# 로깅 설정
LOG_LEVEL=INFO

# CORS 설정 (쉼표로 구분)
ALLOWED_ORIGINS=

# 데이터베이스 연결 풀 설정 (선택사항)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1